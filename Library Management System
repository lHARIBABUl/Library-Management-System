-- Create Issue Details View

CREATE OR REPLACE VIEW issue_details AS
SELECT
    bookIssues.issueID,
    students.studentName,
    students.department,
    books.book_name,
    books.author,
    bookIssues.issueDate,
    bookIssues.returnDate,
    bookIssues.status
FROM bookIssues
JOIN students
    ON bookIssues.studentID = students.studentID
JOIN books
    ON bookIssues.book_id = books.book_id;

-- Display Issue Details View

SELECT *
FROM issue_details;

-- Display Currently Issued Books

SELECT *
FROM issue_details
WHERE status = 'Issued';

-- Display Returned Books

SELECT *
FROM issue_details
WHERE status = 'Returned';

-- Sort Issues By Date

SELECT *
FROM issue_details
ORDER BY issueDate DESC;

-- Top 3 Books By Quantity

SELECT *
FROM books
ORDER BY quantity DESC
LIMIT 3;

-- Check Book Availability

SELECT
    book_name,
    quantity,
    CASE
        WHEN quantity > 0 THEN 'Available'
        ELSE 'Not Available'
    END AS availability
FROM books;

-- Student Issue Count

SELECT
    students.studentName,
    COUNT(bookIssues.issueID) AS total_issues
FROM students
LEFT JOIN bookIssues
    ON students.studentID = bookIssues.studentID
GROUP BY students.studentID, students.studentName;

-- Book Issue Count

SELECT
    books.book_name,
    COUNT(bookIssues.issueID) AS issue_count
FROM books
LEFT JOIN bookIssues
    ON books.book_id = bookIssues.book_id
GROUP BY books.book_id, books.book_name;

