-- Count Total Books

SELECT COUNT(*) AS total_books
FROM books;

-- Count Total Students

SELECT COUNT(*) AS total_students
FROM students;

-- Total Book Quantity

SELECT SUM(quantity) AS total_book_quantity
FROM books;

-- Average Book Quantity

SELECT AVG(quantity) AS average_quantity
FROM books;

-- Maximum Book Quantity

SELECT MAX(quantity) AS maximum_quantity
FROM books;

-- Minimum Book Quantity

SELECT MIN(quantity) AS minimum_quantity
FROM books;

-- Students By Department

SELECT
    department,
    COUNT(*) AS student_count
FROM students
GROUP BY department;

-- Departments With More Than 2 Students

SELECT
    department,
    COUNT(*) AS student_count
FROM students
GROUP BY department
HAVING COUNT(*) > 2;

-- Display Complete Issue Details

SELECT
    bookIssues.issueID,
    students.studentName,
    students.department,
    books.book_name,
    books.author,
    bookIssues.issueDate,
    bookIssues.returnDate,
    bookIssues.status
FROM bookIssues
JOIN students
    ON bookIssues.studentID = students.studentID
JOIN books
    ON bookIssues.book_id = books.book_id;

-- Display Issued Books

SELECT
    students.studentName,
    books.book_name,
    bookIssues.issueDate
FROM bookIssues
JOIN students
    ON bookIssues.studentID = students.studentID
JOIN books
    ON bookIssues.book_id = books.book_id
WHERE bookIssues.status = 'Issued';

-- Display Returned Books

SELECT
    students.studentName,
    books.book_name,
    bookIssues.issueDate,
    bookIssues.returnDate
FROM bookIssues
JOIN students
    ON bookIssues.studentID = students.studentID
JOIN books
    ON bookIssues.book_id = books.book_id
WHERE bookIssues.status = 'Returned';

-- Display CSE Student Issues

